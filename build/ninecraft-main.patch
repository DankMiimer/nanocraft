+/* NANOCRAFT: a field of view setting, which this version of the game does not
+ * have and cannot be given one through its options.
+ *
+ * 0.8.1's entire settings vocabulary is a 21-entry table in the engine, and no
+ * entry in it is FOV. assets/lang/en_US.lang does carry "options.fov=FOV", but
+ * that file is inherited desktop-Minecraft boilerplate -- it also offers 3D
+ * Anaglyph, Advanced OpenGL and a warning about 64-bit *Java* installs -- so a
+ * string there is no evidence the engine implements anything.
+ *
+ * What the engine does have is GameRenderer::getFov(float, bool), an exported
+ * symbol whose result GameRenderer::setupCamera() passes straight to
+ * gluPerspective. Its base value is a single literal in the pool immediately
+ * after the function, the one the first vldr loads into s16. Rewriting that one
+ * word is what Minecraft's own FOV slider does: the sprint and low-health
+ * modifiers stay multiplicative on top of the new base, where adjusting the
+ * return value instead would scale those along with it.
+ *
+ * ItemInHandRenderer::render holds the only other 70.0f in the binary, for the
+ * held-item viewmodel. Vanilla holds that fixed while the slider moves, which is
+ * why the hand does not distort at wide angles, so it is left alone here too.
+ *
+ * The offset of the literal is not hardcoded. A short window after the function
+ * is scanned for the single word reading exactly 70.0f, and anything else --
+ * no match, or more than one -- does nothing rather than write into the middle
+ * of an instruction in a build laid out differently from the one this was read
+ * off.
+ */
+#define FOV_STOCK 70.0f
+#define FOV_STOCK_BITS 0x428c0000u                  /* 70.0f */
+#define FOV_MIN 30.0f
+#define FOV_MAX 110.0f
+#define FOV_SCAN_WORDS 64                           /* the pool is at +0x9c */
+
+static void apply_fov_override(void) {
+    static bool done = false;
+    if (done) {
+        return;
+    }
+    done = true;
+
+    const char *env = getenv("NINECRAFT_FOV");
+    if (env == NULL || env[0] == '\0') {
+        return;
+    }
+    char *end = NULL;
+    float want = strtof(env, &end);
+    if (end == env || want <= 0.0f) {
+        printf("[fov] NINECRAFT_FOV=%s is not a number, left alone\n", env);
+        fflush(stdout);
+        return;
+    }
+    want = fminf(fmaxf(want, FOV_MIN), FOV_MAX);
+    if (want == FOV_STOCK) {
+        /* Asking for the stock angle means leave the game alone, rather than
+         * write 70 over 70 and mprotect a code page for nothing. It also lets
+         * the caller pass a value unconditionally -- run.sh always has one,
+         * because the quick menu always shows one. */
+        return;
+    }
+
+    void *sym = android_dlsym(handle, "_ZN12GameRenderer6getFovEfb");
+    if (sym == NULL) {
+        printf("[fov] this version has no GameRenderer::getFov, left alone\n");
+        fflush(stdout);
+        return;
+    }
+
+    /* A Thumb symbol carries the low bit; the code starts on the even address
+     * and the literal pool after it is word aligned. */
+    uintptr_t base = (((uintptr_t)sym & ~(uintptr_t)1) + 3u) & ~(uintptr_t)3;
+    uint32_t *found = NULL;
+    for (int i = 0; i < FOV_SCAN_WORDS; i++) {
+        uint32_t *w = (uint32_t *)(base + (uintptr_t)i * 4u);
+        if (*w == FOV_STOCK_BITS) {
+            if (found != NULL) {
+                printf("[fov] 70.0 is not unique near getFov, left alone\n");
+                fflush(stdout);
+                return;
+            }
+            found = w;
+        }
+    }
+    if (found == NULL) {
+        printf("[fov] no 70.0 near getFov, left alone\n");
+        fflush(stdout);
+        return;
+    }
+
+    long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        page_size = 4096;
+    }
+    /* The word is 4-aligned, so it cannot straddle two pages. */
+    void *page = (void *)((uintptr_t)found & ~(uintptr_t)(page_size - 1));
+    if (mprotect(page, (size_t)page_size,
+                 PROT_READ | PROT_WRITE | PROT_EXEC) != 0) {
+        printf("[fov] could not make the code page writable, left alone\n");
+        fflush(stdout);
+        return;
+    }
+    memcpy(found, &want, sizeof(want));
+    mprotect(page, (size_t)page_size, PROT_READ | PROT_EXEC);
+
+    printf("[fov] %.1f degrees, was 70.0 (held item stays at 70, as in vanilla)\n",
+           want);
+    fflush(stdout);
 }
 
