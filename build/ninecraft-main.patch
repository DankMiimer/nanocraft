+/* set_ninecraft_size() runs once at startup, typically before MinecraftClient
+ * has a current screen, so its Screen::setSize call does nothing. Every screen
+ * created afterwards keeps whatever size it was built with. Re-apply the real
+ * viewport size each time the current screen changes. */
+static void resize_current_screen_build_1(int width, int height) {
+    void *screen = *(void **)((char *)ninecraft_app +
+                              MINECRAFTCLIENT_SCREEN_OFFSET_0_11_0_BUILD_1);
+    if (!screen || screen == last_sized_screen) {
+        return;
+    }
+    float ddpi = 96.0f;
+    SDL_GetDisplayDPI(SDL_GetWindowDisplayIndex(_window), &ddpi, NULL, NULL);
+    float scale = calculate_scale(width, height, ddpi);
+    int want_width = (int)(width / scale);
+    int want_height = (int)(height / scale);
+    printf("[uifix] screen=%p was %dx%d -> %dx%d\n", screen,
+           ((int *)screen)[SCREEN_WIDTH_INDEX],
+           ((int *)screen)[SCREEN_HEIGHT_INDEX],
+           want_width, want_height);
+    fflush(stdout);
+    ((void (*)(void *, int, int))android_dlsym(handle, "_ZN6Screen7setSizeEii"))(
+        screen, want_width, want_height);
+    last_sized_screen = screen;
+}
