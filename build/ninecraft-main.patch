+/* NANOCRAFT: an interface scale the panel can actually hold.
+ *
+ * calculate_scale() floors at 1.0, which is the right floor for a desktop and
+ * the wrong one for a 240x240 handheld rendering at 120x120. Minecraft's hotbar
+ * sprite is 182x22 GUI pixels -- measured at (0,0) of this build's own gui.png,
+ * where the opaque run ends at x=181 and the 24x24 selection box starts on the
+ * next row -- so a 120-pixel-wide screen laid out at scale 1.0 is 62 pixels too
+ * narrow and loses the ends of the hotbar off both sides. Only a scale below
+ * 1.0 makes it fit, and nothing the game itself stores can ask for one:
+ * gfx_pixeldensity is the touch d-pad's size in pixels per millimetre, which
+ * AppPlatform_linux::getPixelsPerMillimeter() recomputes from the window on
+ * every launch, not a UI scale.
+ *
+ * Unset, this changes nothing on any device. "auto" shrinks the interface just
+ * far enough to fit and never enlarges it, which makes it a no-op at 240x240
+ * too, where the fit scale is already 1.3. "fit" sizes the interface to the
+ * hotbar in both directions, so it grows there instead. An explicit number is
+ * taken as given. Anything unparseable leaves upstream's answer alone rather
+ * than guessing at what was meant.
+ */
+#define GUI_HOTBAR_WIDTH 182
+/* Slack, so the truncation in Screen::setSize's width/scale cannot shave the
+ * last column off the hotbar that auto just made room for. */
+#define GUI_AUTO_SLACK 2
+#define GUI_SCALE_MIN 0.25f
+#define GUI_SCALE_MAX 4.0f
+
+static float gui_scale_override(int width, float scale) {
+    static float last_logged = -1.0f;
+    const char *env = getenv("NINECRAFT_GUI_SCALE");
+    if (env == NULL || env[0] == '\0') {
+        return scale;
+    }
+    if (strcmp(env, "auto") == 0 || strcmp(env, "fit") == 0) {
+        /* The largest scale at which the hotbar still spans the screen.
+         * "auto" only ever shrinks, so a screen that already has room -- any
+         * 240x240 one -- keeps exactly the layout it ships with today. "fit"
+         * also grows into that room, which is worth offering on a 1.54-inch
+         * panel where the interface at scale 1.0 is very small. */
+        float fit = (float)width / (float)(GUI_HOTBAR_WIDTH + GUI_AUTO_SLACK);
+        if (env[0] == 'a' && fit >= scale) {
+            return scale;
+        }
+        scale = fit;
+    } else {
+        char *end = NULL;
+        float wanted = strtof(env, &end);
+        if (end == env || wanted <= 0.0f) {
+            return scale;
+        }
+        scale = wanted;
+    }
+    scale = fminf(fmaxf(scale, GUI_SCALE_MIN), GUI_SCALE_MAX);
+    if (scale != last_logged) {
+        last_logged = scale;
+        printf("[gui] NINECRAFT_GUI_SCALE=%s -> scale %.4f, %d px laid out as %d\n",
+               env, scale, width, (int)((float)width / scale));
+        fflush(stdout);
+    }
+    return scale;
+}
+
 float calculate_scale(int width, int height, float dpi) {
     float dpi_scale = (dpi <= 0.0f) ? 1.0f : (dpi / 96.0f);
     float width_scale = (float)width / 1920.0f;
     float height_scale = (float)height / 1080.0f;
     float combined_scale = (dpi_scale * 1.2) + ((width_scale + height_scale) * 0.8);
     combined_scale = fminf(fmaxf(roundf(combined_scale), 1.0f), 4.0f);
-    return combined_scale;
+    return gui_scale_override(width, combined_scale);
+}
