# A CRLF shebang becomes "#!/bin/sh\r", which BusyBox reports as a missing
# interpreter -- so a Windows clone would otherwise produce an OPK whose scripts
# cannot run on the handheld. The symptom is a one-second black screen and a
# return to the menu, indistinguishable from a segfault.
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.key   text eol=lf
*.desktop text eol=lf
*.md    text eol=lf
*.patch text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
*.ps1   text eol=crlf

# The list of verified kernel builds is compared to `uname` output character
# for character on the console. A CRLF copy matches nothing, and the symptom
# would be NanoCraft refusing to start on the very console it was built for.
opk/modules/kernels text eol=lf

# The kernel configuration the zram modules are built from. A CRLF copy is not
# a valid input to `make olddefconfig`, so it has to survive a Windows clone
# intact for the modules to be rebuildable at all.
*.config text eol=lf

# Binary assets
*.png   binary
*.raw   binary
*.ttf   binary
*.ko    binary
