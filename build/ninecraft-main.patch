+
+static void hide_chat_button(void *handle, int version_id) {
+    const char *setting = getenv("NINECRAFT_CHAT_BUTTON");
+    if (!setting || strcmp(setting, "0") != 0) {
+        return;
+    }
+    if (version_id != version_id_0_8_1) {
+        fprintf(stderr, "[chat-button] only verified for 0.8.1; button left alone\n");
+        return;
+    }
+    void **vtable = (void **)android_dlsym(handle, "_ZTV15XperiaPlayInput");
+    void *render = android_dlsym(handle, "_ZN15XperiaPlayInput6renderEf");
+    /* Check the slot still holds the function it is named after rather than
+       trusting the index, so a differently built library is left alone instead
+       of having some other virtual method replaced. Thumb addresses carry a set
+       low bit; the vtable and the symbol need not agree about it. */
+    if (!vtable || !render ||
+        (((uintptr_t)vtable[5] ^ (uintptr_t)render) & ~(uintptr_t)1) != 0) {
+        fprintf(stderr, "[chat-button] renderer not where expected; button left alone\n");
+        return;
+    }
+    vtable[5] = (void *)xperia_play_input_render_nothing;
+    printf("[chat-button] hidden\n");
+    fflush(stdout);
+}
