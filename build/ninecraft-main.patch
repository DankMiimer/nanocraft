+/* set_ninecraft_size() runs once at startup, typically before MinecraftClient
+ * has a current screen, so its Screen::setSize call does nothing. Every screen
+ * created afterwards keeps whatever size it was built with. Re-apply the real
+ * viewport size each time the current screen changes. */
+static void resize_current_screen_build_1(int width, int height) {
+    void *screen = *(void **)((char *)ninecraft_app +
+                              MINECRAFTCLIENT_SCREEN_OFFSET_0_11_0_BUILD_1);
