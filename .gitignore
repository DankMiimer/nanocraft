# never commit game content, build output, or anything personal
*.apk
*.opk
*libminecraftpe*
game*/
home/
# The release archives and the payload are large and rebuildable. The scripts
# that assemble them are neither, and they carry the check that keeps a release
# from shipping a runtime its own launcher does not match - see release/.
release/*
!release/*.sh
out*/
*.raw
*.log
*.bak
__pycache__/

# Build input, not redistributed: the menu font is supplied by the builder.
# See opk/make-menu-bg.sh. Only the rendered menubg.raw ships.
menufont.ttf
