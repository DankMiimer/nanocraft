CLEAR
MAP UP       TO KEY     KEY_PAGEUP
MAP DOWN     TO KEY     KEY_PAGEDOWN
MAP LEFT     TO KEY     KEY_RIGHT
MAP RIGHT    TO KEY     KEY_END
MAP A        TO KEY     KEY_SPACE
MAP B        TO KEY     KEY_LEFTCTRL
MAP X        TO KEY     KEY_LEFTSHIFT
MAP Y        TO KEY     KEY_LEFTALT
MAP R        TO KEY     KEY_T
MAP L        TO KEY     KEY_BACKSPACE
MAP START    TO KEY     KEY_ENTER
MAP FN       TO KEY     KEY_KPSLASH
MAP MENU     TO KEY     KEY_ESC
MAP L+X      TO KEY     KEY_E
MAP L+START  TO KEY     KEY_TAB
MAP L+FN     TO COMMAND /mnt/FunKey/nanocraft/pemenu.sh
